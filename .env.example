# Sao chép file này thành .env.local khi chạy ở máy, và khai báo 2 biến này trong
# Cloudflare (Settings → Build → Variables) khi triển khai.
# Lấy giá trị tại Supabase Dashboard → Project Settings → API.
# Cả hai đều là giá trị CÔNG KHAI (an toàn khi nằm trong mã trình duyệt);
# TUYỆT ĐỐI không đưa service_role key vào đây.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Địa chỉ chính thức của web (dùng cho sitemap và thẻ chia sẻ mạng xã hội).
NEXT_PUBLIC_SITE_URL=https://example.com

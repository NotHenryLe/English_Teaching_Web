{
  "name": "english-teaching-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler dev",
    "deploy": "next build && wrangler deploy",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seed:build": "node scripts/build-seed.ts",
    "local:up": "bash supabase/local/up.sh",
    "local:down": "docker compose -f supabase/local/docker-compose.yml down -v",
    "test:rls": "node --test tests/rls.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:content": "node --test tests/content.test.ts",
    "test": "node --test tests/content.test.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
